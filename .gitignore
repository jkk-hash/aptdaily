# 숨김 폴더 전체 제외 (단, .github 폴더는 예외)
.*/
!.github/
!.github/**

# 문서 폴더 제외
docs/

# 환경 변수 및 시크릿 키
.env
.env.*
!.env.example

# Python 컴파일 및 빌드 아티팩트
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 가상환경 및 테스트 캐시
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 에디터 및 OS 임시 파일
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
